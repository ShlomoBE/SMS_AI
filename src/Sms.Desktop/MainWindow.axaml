<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sms.Desktop.MainWindow"
        Title="Sega Master System Emulator v1.7.0"
        Width="800" Height="600"
        MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Sms.Desktop/Assets/App.ico"
        Focusable="True"
        DragDrop.AllowDrop="True">

    <DockPanel LastChildFill="True">

        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#1E1E1E">
            <MenuItem Header="_File">
                <MenuItem Header="Open _ROM..." Click="OnFileOpenRom_Click" InputGesture="Ctrl+O" />
                <MenuItem Header="Open _BIOS..." Click="OnFileOpenBios_Click" />
                <MenuItem Header="_Settings..." Click="OnSettings_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnFileExit_Click" />
            </MenuItem>
            <MenuItem Header="_Emulation">
                <MenuItem x:Name="MenuPause" Header="_Pause / Resume" Click="OnEmulationPause_Click" InputGesture="P" />
                <MenuItem Header="_Reset" Click="OnEmulationReset_Click" InputGesture="Ctrl+R" />
                <Separator />
                <MenuItem Header="Quick _Save State" Click="OnQuickSaveState_Click" InputGesture="F5" />
                <MenuItem Header="Quick _Load State" Click="OnQuickLoadState_Click" InputGesture="F8" />
                <MenuItem Header="Save State _ToFile..." Click="OnSaveStateFile_Click" />
                <MenuItem Header="Load State _FromFile..." Click="OnLoadStateFile_Click" />
            </MenuItem>
            <MenuItem Header="_Video">
                <MenuItem x:Name="MenuVideoNtsc" Header="NTSC (60 Hz)" Click="OnVideoNtsc_Click" ToggleType="Radio" IsChecked="True" />
                <MenuItem x:Name="MenuVideoPal" Header="PAL (50 Hz)" Click="OnVideoPal_Click" ToggleType="Radio" />
            </MenuItem>
            <MenuItem Header="_Audio">
                <MenuItem x:Name="MenuAudioAuto" Header="Automatic" Click="OnAudioAuto_Click" ToggleType="Radio" IsChecked="True" />
                <MenuItem x:Name="MenuAudioForcePsg" Header="Force PSG" Click="OnAudioForcePsg_Click" ToggleType="Radio" />
                <MenuItem x:Name="MenuAudioForceFm" Header="Force FM" Click="OnAudioForceFm_Click" ToggleType="Radio" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Open _Debugger..." Click="OnOpenDebugger_Click" InputGesture="Ctrl+D" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Controls &amp; Hotkeys" Click="OnHelpControls_Click" />
            </MenuItem>
        </Menu>

        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#181818" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="No ROM Loaded — Drop a .sms file to play" Foreground="#CCCCCC" VerticalAlignment="Center" FontSize="12" />
                <TextBlock x:Name="RomInfoText" Grid.Column="1" Text="" Foreground="#888888" Margin="16,0" VerticalAlignment="Center" FontSize="12" />
                <TextBlock x:Name="SoundRoutingText" Grid.Column="2" Text="Mixer: —" ToolTip.Tip="Enabled mixer routing, not detected game sound or audible volume" Foreground="#888888" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12" />
                <TextBlock x:Name="FpsText" Grid.Column="3" Text="0.0 FPS" Foreground="#4CAF50" VerticalAlignment="Center" FontSize="12" FontFamily="Consolas, monospace" FontWeight="Bold" />
            </Grid>
        </Border>

        <!-- Main Display Canvas -->
        <Grid Background="#050505" DragDrop.AllowDrop="True">
            <Image x:Name="DisplayImage" Stretch="Uniform" />

            <!-- Drag & Drop overlay label when empty -->
            <StackPanel x:Name="DropPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <Image Source="avares://Sms.Desktop/Assets/Logo.png" MaxWidth="300" MaxHeight="180" Stretch="Uniform" />
                <TextBlock Text="🎮 Sega Master System v1.7.0" FontSize="24" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center" />
                <TextBlock Text="Drag and drop a .sms or .bin ROM file here" FontSize="14" Foreground="#444444" HorizontalAlignment="Center" />
                <TextBlock Text="Or click File -> Open ROM..." FontSize="12" Foreground="#333333" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Floating Toast Popup Notification in Bottom-Right Corner -->
            <Border x:Name="NotificationToast"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,20"
                    Background="#EE181825"
                    BorderBrush="#45475A"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="14,10"
                    IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="NotificationIcon" Text="🔄" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="NotificationText" Text="System Reset" FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
